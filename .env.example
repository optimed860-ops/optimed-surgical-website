# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase values: Supabase dashboard → Project Settings → API Keys / Data API.

# ── Public (safe to expose to the browser) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only (NEVER add the NEXT_PUBLIC_ prefix to these) ────────────────
SUPABASE_SECRET_KEY=

# Random secret used to hash visitor IPs for rate limiting (32+ characters).
RATE_LIMIT_HMAC_SECRET=

# Optional: free email alert to the admin for every quote/contact form (Gmail + App Password).
# Leave SMTP_PASS empty to turn emails off. Never commit real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# Resend (used instead of Gmail when RESEND_API_KEY is filled in). Free plan.
# Without your own domain: keep EMAIL_FROM=onboarding@resend.dev and set NOTIFY_EMAIL
# to the email you signed up to Resend with.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Google Search Console → HTML tag method: paste only the content="…" code here (optional).
GOOGLE_SITE_VERIFICATION=
